{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "RUN_TRACE.schema.json",
    "title": "Multi-Agent Run Trace",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "runs"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schema_version": {
            "const": "1.0.0"
        },
        "runs": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/run"
            }
        }
    },
    "$defs": {
        "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "sha256": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "amount",
                "currency",
                "source",
                "unavailable_reason"
            ],
            "properties": {
                "amount": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0
                },
                "currency": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "unavailable_reason": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "input_tokens",
                "output_tokens",
                "cached_tokens",
                "total_tokens",
                "cost",
                "unavailable_reason"
            ],
            "properties": {
                "input_tokens": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "output_tokens": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "cached_tokens": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "total_tokens": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "cost": {
                    "$ref": "#/$defs/cost"
                },
                "unavailable_reason": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "tool_call": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "tool",
                "action_summary",
                "status"
            ],
            "properties": {
                "tool": {
                    "type": "string",
                    "minLength": 1
                },
                "action_summary": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": [
                        "succeeded",
                        "failed",
                        "blocked",
                        "cancelled"
                    ]
                },
                "started_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "ended_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                }
            }
        },
        "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "class",
                "summary",
                "resolution"
            ],
            "properties": {
                "class": {
                    "enum": [
                        "transient",
                        "implementation",
                        "contract",
                        "permission",
                        "security",
                        "context",
                        "environment"
                    ]
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "resolution": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "agent_execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "agent",
                "role",
                "status",
                "started_at",
                "ended_at",
                "elapsed_ms",
                "acceptance_criteria",
                "prompt_summary",
                "input_artifacts",
                "output_artifacts",
                "decisions",
                "tool_calls",
                "errors",
                "retry_count",
                "remediation_cycles",
                "usage",
                "redactions"
            ],
            "properties": {
                "agent": {
                    "type": "string",
                    "minLength": 1
                },
                "role": {
                    "type": "string",
                    "minLength": 1
                },
                "model": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "charter_sha256": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                },
                "status": {
                    "enum": [
                        "planned",
                        "running",
                        "blocked",
                        "failed",
                        "completed",
                        "cancelled",
                        "superseded"
                    ]
                },
                "started_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "ended_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "elapsed_ms": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "acceptance_criteria": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "prompt_summary": {
                    "type": "string"
                },
                "input_artifacts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/artifact"
                    }
                },
                "output_artifacts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/artifact"
                    }
                },
                "decisions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tool_calls": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/tool_call"
                    }
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/error"
                    }
                },
                "retry_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "remediation_cycles": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                },
                "usage": {
                    "$ref": "#/$defs/usage"
                },
                "redactions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "run_id",
                "parent_run_id",
                "objective",
                "status",
                "started_at",
                "ended_at",
                "elapsed_ms",
                "repository_commit",
                "working_tree_dirty",
                "acceptance_criteria",
                "child_run_ids",
                "agents",
                "gate_decisions",
                "usage",
                "summary"
            ],
            "properties": {
                "run_id": {
                    "type": "string",
                    "minLength": 1
                },
                "parent_run_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "objective": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": [
                        "planned",
                        "running",
                        "blocked",
                        "failed",
                        "completed",
                        "cancelled"
                    ]
                },
                "started_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "ended_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "elapsed_ms": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "repository_commit": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "working_tree_dirty": {
                    "type": "boolean"
                },
                "acceptance_criteria": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "child_run_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "agents": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/agent_execution"
                    }
                },
                "gate_decisions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "usage": {
                    "$ref": "#/$defs/usage"
                },
                "summary": {
                    "type": "string"
                }
            }
        }
    }
}
